# Shell aliases.
alias l = ls
alias la = ls -a
alias ll = ls -la
alias c = clear
alias q = exit
alias ff = fastfetch
alias zj = zellij

# Safety guardrails for file operations.
alias cp = ^cp -iv
alias mv = ^mv -iv
alias rm = ^rm -vI

# Development shortcuts.
alias v = nvim
alias g = git
alias gs = git status
alias ga = git add
alias lg = lazygit
alias lzd = lazydocker
