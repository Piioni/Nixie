{
  "autoMemoryEnabled": false,
  "dialogExpiry": "5m",
  "effortLevel": "high",
  "enabledPlugins": {
    "engram@engram": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "repo": "Gentleman-Programming/engram",
        "source": "github"
      }
    }
  },
  "footerLinksRegexes": [
    {
      "label": "{id}",
      "pattern": "(?<id>POS-\\d+)",
      "type": "regex",
      "url": "https://linear.app/sipay/issue/{id}"
    }
  ],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/piioni/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": false,
            "command": "'/home/piioni/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/piioni/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/piioni/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "gentle-ai sdd-preflight-hook --agent claude-code",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/piioni/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/piioni/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/piioni/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "gentle-ai review stop-hook --agent claude-code",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "bash '/home/piioni/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact|fork)$"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/piioni/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "gentle-ai review stop-hook --agent claude-code",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "gentle-ai telemetry runtime claude --json",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/piioni/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "gentle-ai telemetry runtime claude --json",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "gentle-ai skill-registry refresh --quiet --no-gitignore --cwd \"${CLAUDE_PROJECT_DIR:-$PWD}\" || true",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/home/piioni/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "outputStyle": "Gentleman",
  "permissions": {
    "allow": [
      "Read(**)",
      "Read(~/**)",
      "Read(//**)",
      "Glob",
      "Grep",
      "Bash(eza *)",
      "Bash(fvm flutter analyze *)",
