{
  "editor.formatOnSave": true,

  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },

  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": ["nixfmt"]
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.piioni.options"
        }
      }
    }
  }
}
